# Local Velociraptor lab config.
# Copy to integrations/velociraptor/config.env and edit locally if needed.
# This file is safe to commit; config.env is ignored by git.

# Velociraptor server runs on the collector VM.
VELOCIRAPTOR_SERVER_HOST="10.20.0.30"
VELOCIRAPTOR_SERVER_SSH_USER="${LAB_ADMIN_USER:-${USER:-labadmin}}"

# Clients use lab-detonation so they continue to check in during detonation mode.
VELOCIRAPTOR_FRONTEND_HOST="10.30.0.30"
VELOCIRAPTOR_FRONTEND_PORT="8001"
VELOCIRAPTOR_GUI_HOST="10.30.0.30"
VELOCIRAPTOR_GUI_PORT="8889"

# Collector-local paths and service settings.
VELOCIRAPTOR_BIN="/usr/local/bin/velociraptor"
VELOCIRAPTOR_CONFIG_DIR="/etc/velociraptor"
VELOCIRAPTOR_DATASTORE="/var/lib/velociraptor"
VELOCIRAPTOR_INSTALLER_DIR="/opt/lab-env/velociraptor"
VELOCIRAPTOR_INSTALLER_HTTP_PORT="8082"
VELOCIRAPTOR_RUN_USER="velociraptor"

# "latest" resolves via the official GitHub releases API on the collector VM.
# You can pin a release tag such as "v0.74.5" if a future release breaks the lab.
VELOCIRAPTOR_VERSION="latest"

# Lab GUI user. Do not use these credentials outside a throwaway lab.
VELOCIRAPTOR_GUI_USER="admin"
VELOCIRAPTOR_GUI_PASSWORD="VelociLab123!"

# Endpoint install defaults.
VELOCIRAPTOR_CLIENT_INSTALL_DIR_LINUX="/opt/velociraptor"
VELOCIRAPTOR_CLIENT_CONFIG_LINUX="/etc/velociraptor/client.config.yaml"
VELOCIRAPTOR_CLIENT_INSTALL_DIR_WINDOWS='C:\Program Files\Velociraptor'
VELOCIRAPTOR_CLIENT_SERVICE_NAME="Velociraptor"
