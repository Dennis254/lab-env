# Local private config for integrations/custom.
# Copy to integrations/custom/config.env and edit locally.
# This file is safe to commit; config.env is ignored by git.

CUSTOM_SIEM_URL="https://10.20.0.1:8443"
CUSTOM_SIEM_TENANT="lab"
CUSTOM_AGENT_MODE="observe"

# Optional host-side server commands.
# They run on the lab host.
CUSTOM_SIEM_SERVER_INSTALL_COMMAND=""
CUSTOM_SIEM_SERVER_VERIFY_COMMAND=""

# Optional Linux agent commands.
# They run inside the Linux target via SSH as root.
CUSTOM_AGENT_LINUX_INSTALL_COMMAND=""
CUSTOM_AGENT_LINUX_VERIFY_COMMAND=""
CUSTOM_AGENT_LINUX_REMOVE_COMMAND=""

# Optional Windows agent commands.
# They run inside the Windows target through QEMU Guest Agent as LocalSystem.
CUSTOM_AGENT_WINDOWS_INSTALL_COMMAND=""
CUSTOM_AGENT_WINDOWS_VERIFY_COMMAND=""
CUSTOM_AGENT_WINDOWS_REMOVE_COMMAND=""

# Example command shape only:
# CUSTOM_AGENT_LINUX_INSTALL_COMMAND='curl -fsSL https://10.20.0.1:8443/install/linux.sh | bash -s -- --url "$CUSTOM_SIEM_URL" --tenant "$CUSTOM_SIEM_TENANT" --mode "$CUSTOM_AGENT_MODE"'
# CUSTOM_AGENT_WINDOWS_INSTALL_COMMAND='iwr -UseBasicParsing https://10.20.0.1:8443/install/windows.ps1 | iex'
