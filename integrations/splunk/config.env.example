# Local Splunk lab config.
# Copy to integrations/splunk/config.env and edit locally.
# This file is safe to commit; config.env is ignored by git.

# Splunk Enterprise runs inside the lab on the splunk VM.
SPLUNK_SERVER_HOST="10.20.0.30"
SPLUNK_SERVER_SSH_USER="dennis"
SPLUNK_SERVER_DETO_HOST="10.30.0.30"
SPLUNK_HOME="/opt/splunk"
SPLUNK_PACKAGE=""
SPLUNK_ADMIN_USER="admin"
SPLUNK_ADMIN_PASSWORD=""
SPLUNK_RECEIVER_PORT="9997"
SPLUNK_WEB_URL="http://10.20.0.30:8000"
SPLUNK_ENABLE_BOOT_START="true"
SPLUNK_RUN_USER="splunk"
SPLUNK_ENABLE_NORMALIZATION="true"

# Forwarders send telemetry to Splunk over lab-detonation so forwarding still
# works while lab-mgmt is down in detonation mode.
SPLUNK_INDEXER_HOST="10.30.0.30"
SPLUNK_INDEXES="endpoint wineventlog sysmon linux"

# Linux Universal Forwarder.
SPLUNK_UF_HOME="/opt/splunkforwarder"
SPLUNK_UF_LINUX_PACKAGE=""
SPLUNK_UF_ADMIN_USER="admin"
SPLUNK_UF_PASSWORD=""

# Windows Universal Forwarder. server.sh copies this package to the splunk VM
# and serves it from SPLUNK_SERVER_HOST:SPLUNK_INSTALLER_HTTP_PORT.
SPLUNK_UF_WINDOWS_PACKAGE=""
SPLUNK_INSTALLER_DIR="/opt/lab-env/installers"
SPLUNK_INSTALLER_HTTP_PORT="8081"
SPLUNK_UF_WINDOWS_URL=""
SPLUNK_UF_WINDOWS_HOME='C:\Program Files\SplunkUniversalForwarder'

# Optional deployment server, if you later use Splunk deployment apps.
SPLUNK_DEPLOYMENT_SERVER=""
